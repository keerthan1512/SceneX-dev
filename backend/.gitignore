# =============================================================================
# Backend .gitignore (Python / FastAPI)
# =============================================================================

# Environment variables & secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.dmypy.json

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ML model files (large binaries — store with DVC or Git LFS instead)
*.pt
*.pth
*.onnx
*.pkl
*.h5
*.pb
*.tflite
*.joblib

# Storage / uploads (runtime data)
storage/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
